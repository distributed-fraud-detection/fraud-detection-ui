# Production environment — values injected by the container runtime / CI-CD
# NEVER commit real secrets or prod URLs here.
# This file is safe to commit; actual values come from Docker env / Kubernetes secrets.

# Points to the public-facing API gateway (e.g. load balancer or domain)
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth2 Client ID — MUST be set in CI/CD pipeline secrets
VITE_GOOGLE_CLIENT_ID=

# Kafka UI — typically not exposed in prod; leave empty to hide the nav link
VITE_KAFKA_UI_URL=
