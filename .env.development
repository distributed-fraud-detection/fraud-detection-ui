# Dev-only overrides — used by `npm run dev` against a local backend.
# These values are resolved by Vite after .env (base) is loaded.
# The dev proxy in vite.config.js handles CORS automatically.

# VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
VITE_KAFKA_UI_URL=http://localhost:8090
